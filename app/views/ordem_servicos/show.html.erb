<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar Ordem Servico</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @ordem_servico %>">
          <p>
            <strong>Cliente:</strong>
            <%= @ordem_servico.cliente %>
          </p>
          <p>
            <strong>Status:</strong>
            <%= @ordem_servico.status %>
          </p>
          <p>
            <strong>Data Agendamento:</strong>
            <%= @ordem_servico.data_agendamento %>
          </p>
          <p>
            <strong>Data Fechamento:</strong>
            <%= @ordem_servico.data_fechamento %>
          </p>
          <p>
            <strong>Observacao:</strong>
            <%= @ordem_servico.observacao %>
          </p>
          <p>
            <strong>Prioridade:</strong>
            <%= @ordem_servico.prioridade %>
          </p>
          <p>
            <strong>Valor Toal:</strong>
            <%= @ordem_servico.valor_toal %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_ordem_servico_path(@ordem_servico), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", ordem_servicos_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @ordem_servico, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
