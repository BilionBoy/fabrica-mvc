<!-- app/views/clientes/_endereco_fields.html.erb -->
<div class="nested-fields">
  <%= f.text_field :logradouro, placeholder: "Logradouro" %>
  <%= f.text_field :complemento, placeholder: "Bairro" %>
  <%= f.text_field :cidade, placeholder: "Cidade" %>
  <%= f.text_field :cep, placeholder: "CEP" %>
  <%= f.hidden_field :_destroy %>
  <%= link_to "Remover endereço", "#", data: { action: "click->nested-form#remove" } %>
</div>

