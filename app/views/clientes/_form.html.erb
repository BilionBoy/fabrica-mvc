
<div class="climastock-page">
  
  <div class="climastock-page-header">
    <div class="climastock-header-content">
      <div class="climastock-header-left">
        <div class="climastock-icon-wrapper">
          <i class="ph-<%= @cliente.new_record? ? 'plus-circle' : 'pen' %>"></i>
        </div>
        <div class="climastock-header-text">
          <h1 class="climastock-page-title">
            <%= @cliente.new_record? ? "Novo" : "Editar" %> 
            <%= Cliente.model_name.human %>
          </h1>
          <p class="climastock-page-subtitle">
            Preencha os campos abaixo para <%= @cliente.new_record? ? "criar um novo" : "atualizar o" %> registro
          </p>
        </div>
      </div>
      <div class="climastock-header-right">
        <%= link_to clientes_path, class: "climastock-btn climastock-btn-secondary" do %>
        <i class="ph-arrow-left"></i>
        <span>Voltar</span>
        <% end %>
      </div>
    </div>
  </div>
  
  <%= simple_form_for(@cliente, html: { class: "climastock-form" }) do |f| %>
  <div class="climastock-form-card">
    
    <% if @cliente.errors.any? %>
    <div class="climastock-alert climastock-alert-danger">
      <div class="climastock-alert-icon">
        <i class="ph-warning-circle"></i>
      </div>
      <div class="climastock-alert-content">
        <h4 class="climastock-alert-title">
          <%= pluralize(@cliente.errors.count, "erro") %> encontrado<%= @cliente.errors.count > 1 ? "s" : "" %>
        </h4>
        <ul class="climastock-alert-list">
          <% @cliente.errors.full_messages.each do |message| %>
          <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
    <% end %>
    
    <div class="climastock-form-body">
      <div class="climastock-form-grid">
                  <div class="climastock-form-group">
            <%= f.input :nome,
            wrapper_html: { class: "climastock-input-wrapper" },
            input_html: { class: "climastock-input" },
            label_html: { class: "climastock-label" } %>
          </div>
              </div>
    </div>
<div data-controller="nested-form">
    <h3>Endereços</h3>
    <div data-nested-form-target="target">
      <%= f.fields_for :enderecos do |ef| %>
        <%= render "endereco_fields", f: ef %>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <%= f.fields_for :enderecos, @cliente.enderecos.build, child_index: "NEW_RECORD" do |ef| %>
        <%= render "endereco_fields", f: ef %>
      <% end %>
    </template>
    <%= link_to "Adicionar outro endereço", "#", data: { action: "click->nested-form#add" } %>
  </div>

  <div data-controller="nested-form">
    <h3>Telefones</h3>
    <div data-nested-form-target="target">
      <%= f.fields_for :telefones do |tf| %>
        <%= render "telefone_fields", f: tf %>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <%= f.fields_for :telefones, @cliente.telefones.build, child_index: "NEW_RECORD" do |tf| %>
        <%= render "telefone_fields", f: tf %>
      <% end %>
    </template>
    <%= link_to "Adicionar telefone", "#", data: { action: "click->nested-form#add" } %>
  </div>

    <div class="climastock-form-footer">
      <div class="climastock-form-actions">
        <%= link_to clientes_path, class: "climastock-btn climastock-btn-outline" do %>
        <i class="ph-x"></i>
        <span>Cancelar</span>
        <% end %>
        <%= f.button :submit, 
                class: "climastock-btn climastock-btn-primary" do %>
          <i class="ph-check-circle"></i>
          <span><%= @cliente.new_record? ? "Criar Registro" : "Salvar Alterações" %></span>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>