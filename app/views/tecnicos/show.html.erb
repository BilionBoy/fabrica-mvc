<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar Tecnico</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @tecnico %>">
          <p>
            <strong>Nome:</strong>
            <%= @tecnico.nome %>
          </p>
          <p>
            <strong>Telefone:</strong>
            <%= @tecnico.telefone %>
          </p>
          <p>
            <strong>Funcao:</strong>
            <%= @tecnico.funcao %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_tecnico_path(@tecnico), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", tecnicos_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @tecnico, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
